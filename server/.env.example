# Copy to .env, fill in, then: npm run start:env
# At least one provider key is required.

# Claude (Anthropic) — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low            # low | medium | high (more thorough, slower, costs more)

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# Which provider the app uses when it doesn't ask for one (anthropic | openrouter)
# DEFAULT_PROVIDER=anthropic

# Strongly recommended: the app must send this as its access token.
# Generate one with: openssl rand -hex 32
ZENVORA_ACCESS_TOKEN=

# Comma-separated origins allowed to call the server from a browser.
# The desktop app sends "null"; add your web preview's origin if you host one.
# ALLOWED_ORIGINS=null,https://preview.example.com

# PORT=8787
# HOST=0.0.0.0
# RATE_LIMIT_PER_MINUTE=30
